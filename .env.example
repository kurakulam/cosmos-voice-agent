# ════════════════════════════════════════════════════════════════════════════
# COSMOS Voice Agent – Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to source control.
# ════════════════════════════════════════════════════════════════════════════

# ── Google Cloud Project ────────────────────────────────────────────────────
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1

# ── Vertex AI Search ────────────────────────────────────────────────────────
# The data store ID you created in Vertex AI Search
VERTEX_SEARCH_DATASTORE_ID=cosmos-knowledge-base

# ── Gemini Live ─────────────────────────────────────────────────────────────
# Available Gemini Live models (check docs for latest):
GEMINI_MODEL=gemini-2.0-flash-live-preview

# Voice options: Aoede, Charon, Fenrir, Kore, Puck
GEMINI_VOICE=Aoede

# ── RAG Settings ────────────────────────────────────────────────────────────
# Number of knowledge chunks to retrieve per query
RAG_TOP_K=5

# ── App Settings ────────────────────────────────────────────────────────────
PORT=8080
DEBUG=false

# Comma-separated list of allowed CORS origins
# Use * for development, restrict in production
ALLOWED_ORIGINS=["*"]
